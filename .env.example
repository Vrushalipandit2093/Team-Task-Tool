# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Company Email (SMTP) ──────────────────────────────────────────────────────

# Your company email address (used as the sender)
EMAIL_USER=yourname@yourcompany.com

# Your email password (same as what you use to log in to Outlook/Webmail)
EMAIL_PASS=your_email_password

# Name shown in the "From" field of reminder emails
SENDER_NAME=Cluster Lead

# Actual email address shown in the "From" field.
# Required for providers like AWS SES where EMAIL_USER is an SMTP username, not an email address.
SENDER_EMAIL=lead@yourcompany.com

# Admin login for reminder sending
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=change_me
ADMIN_SESSION_SECRET=change_this_secret
MEMBER_SESSION_SECRET=change_this_member_secret

# ── SMTP Server Settings ──────────────────────────────────────────────────────
# Ask your IT team for these values if you're unsure

# SMTP host (examples below)
SMTP_HOST=mail.yourcompany.com

# Common port numbers:
#   587  → most company mail servers (TLS/STARTTLS) ← use this first
#   465  → SSL (set SMTP_SECURE=true)
#   25   → old servers (usually blocked)
SMTP_PORT=587

# Set to true only if using port 465
SMTP_SECURE=false

# Set to false only if your company uses a self-signed certificate
SMTP_REJECT_UNAUTHORIZED=true

# ── Examples for common setups ────────────────────────────────────────────────

# Microsoft 365 / Office 365:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false

# Google Workspace (company Gmail):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# EMAIL_PASS=<App Password from myaccount.google.com>

# Zoho Mail:
# SMTP_HOST=smtp.zoho.in
# SMTP_PORT=587
# SMTP_SECURE=false

# On-premise Exchange:
# SMTP_HOST=mail.yourcompany.com  (ask IT for exact hostname)
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_REJECT_UNAUTHORIZED=false  (if self-signed cert)

# ── App Settings ──────────────────────────────────────────────────────────────
PORT=3000
